# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=staycircle
DB_USER=postgres
DB_PASSWORD=your_password

# Authentication (JWT)
JWT_SECRET=replace_with_a_strong_secret
JWT_EXPIRES_IN=7d

# Security & Rate Limiting
CORS_ORIGIN=*
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
